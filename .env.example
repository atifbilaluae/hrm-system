# ------------------------------------------------------------------
# Copy this file to .env before running: cp .env.example .env
# Never commit the real .env. Every secret below must be changed
# before this system goes anywhere near production.
# ------------------------------------------------------------------

# --- Environment ---
ASPNETCORE_ENVIRONMENT=Development

# --- SQL Server ---
# Must satisfy SQL Server complexity rules: 8+ chars, upper, lower, digit/symbol.
SQL_SA_PASSWORD=Your_password123
SQL_PORT=1433

# --- Redis ---
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_USER=hrm
RABBITMQ_PASSWORD=hrm_dev_password
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# --- JWT ---
# Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_super_secret_key_at_least_32_chars_long_123456
JWT_ISSUER=hrm.identity
JWT_AUDIENCE=hrm.clients
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# --- Seed data ---
SEED_ADMIN_EMAIL=admin@hrm.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_DATA=true

# --- Email (notification service). Disabled in dev: emails are logged instead. ---
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# --- Ports and URLs ---
# Change a host port here if something else already owns it. The port INSIDE
# each container never changes, so no service configuration has to be touched.
GATEWAY_PORT=8080
FRONTEND_PORT=3000

# Set SQL_PORT=1434 if you also run SQL Server natively on this machine,
# otherwise both will fight over 1433.

# Resolved by the BROWSER, not by Docker - so it is localhost plus the
# published gateway port, never http://api-gateway:8080.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Must match exactly where the frontend runs, including the port.
CORS_ALLOWED_ORIGINS=http://localhost:3000
