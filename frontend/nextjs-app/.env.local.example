# ---------------------------------------------------------------------------
# Copy to .env.local. Next.js reads this at STARTUP only - restart the dev
# server after changing it.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle, so this must
# always be the URL your BROWSER can reach - never an internal Docker hostname
# like http://api-gateway:8080.
# ---------------------------------------------------------------------------

# Scenario 1 - backend running from Visual Studio (gateway on port 5000)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Scenario 2 - backend running in Docker (gateway published on 8080).
# Comment out the line above and uncomment this one.
# NEXT_PUBLIC_API_URL=http://localhost:8080
