{
  "Jwt": {
    "Secret": "CHANGE_ME_super_secret_key_at_least_32_chars_long_123456",
    "Issuer": "hrm.identity",
    "Audience": "hrm.clients"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:3000"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "identity-users": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "employees": {
        "ClusterId": "employee",
        "Match": {
          "Path": "/api/employees/{**catch-all}"
        }
      },
      "notifications": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "swagger-identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/identity/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identity"
          }
        ]
      },
      "swagger-employee": {
        "ClusterId": "employee",
        "Match": {
          "Path": "/employee/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/employee"
          }
        ]
      },
      "departments": {
        "ClusterId": "organization",
        "Match": {
          "Path": "/api/departments/{**catch-all}"
        }
      },
      "designations": {
        "ClusterId": "organization",
        "Match": {
          "Path": "/api/designations/{**catch-all}"
        }
      },
      "branches": {
        "ClusterId": "organization",
        "Match": {
          "Path": "/api/branches/{**catch-all}"
        }
      },
      "holidays": {
        "ClusterId": "organization",
        "Match": {
          "Path": "/api/holidays/{**catch-all}"
        }
      },
      "attendance": {
        "ClusterId": "attendance",
        "Match": {
          "Path": "/api/attendance/{**catch-all}"
        }
      },
      "leave": {
        "ClusterId": "leave",
        "Match": {
          "Path": "/api/leave/{**catch-all}"
        }
      },
      "leave-types": {
        "ClusterId": "leave",
        "Match": {
          "Path": "/api/leave-types/{**catch-all}"
        }
      },
      "swagger-organization": {
        "ClusterId": "organization",
        "Match": {
          "Path": "/organization/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/organization"
          }
        ]
      },
      "swagger-attendance": {
        "ClusterId": "attendance",
        "Match": {
          "Path": "/attendance/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/attendance"
          }
        ]
      },
      "swagger-leave": {
        "ClusterId": "leave",
        "Match": {
          "Path": "/leave/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/leave"
          }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://identity-service:8080/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      },
      "employee": {
        "Destinations": {
          "d1": {
            "Address": "http://employee-service:8080/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      },
      "notification": {
        "Destinations": {
          "d1": {
            "Address": "http://notification-service:8080/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      },
      "organization": {
        "Destinations": {
          "d1": {
            "Address": "http://organization-service:8080/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      },
      "attendance": {
        "Destinations": {
          "d1": {
            "Address": "http://attendance-service:8080/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      },
      "leave": {
        "Destinations": {
          "d1": {
            "Address": "http://leave-service:8080/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}